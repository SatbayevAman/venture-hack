# ANTHROPIC_API_KEY = "sk-ant-..."
# или OpenAI-совместимый провайдер:
# LLM_PROVIDER = "openai"
# OPENAI_API_KEY = "..."
# LLM_MODEL = "gpt-4o"
# LLM_BASE_URL = "https://api.openai.com/v1"   # для Gemini: https://generativelanguage.googleapis.com/v1beta/openai/

# Вход и роли. Streamlit (и Streamlit Community Cloud) отдаёт корневые ключи этого файла
# как переменные окружения, поэтому настройки входа задаются здесь же.

# Администратор создаётся при запуске; без этих двух строк администратора нет.
# PORTRET_ADMIN_LOGIN = "admin"
# PORTRET_ADMIN_PASSWORD = "..."

# Кнопки «Войти как демо-учитель / демо-ученик». Для настоящей школы — "0".
# PORTRET_DEMO = "0"

# PORTRET_AUTH = "off" на публичной ссылке не задавать: вход отключается, каждый посетитель — администратор.
